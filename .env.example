# ==============================================================================
# AnonChat Environment Configuration
# ==============================================================================

# Node / Backend Port
PORT=5001

# PostgreSQL Database Connection String
# Defaults to local PostgreSQL running on macOS / Linux
DATABASE_URL=postgres://localhost:5432/anon_chat

# JWT Secret for Cryptographic Session Signing
JWT_SECRET=super_secret_anon_chat_jwt_key_please_change_in_production_2026

# (Optional) Supabase Configuration
# If connecting directly to a remote Supabase project
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
